{
   "manifest_version": 3,
   "name": "Minimalist New Tab Page",
   "short_name": "Minimalist NTP",
   "version": "1.6.0",
   "description": "A clean and minimalist new tab page with a clock and your favorite links.",
   "chrome_url_overrides": {
      "newtab": "index.html"
   },
   "permissions": [
      "storage"
   ],
   "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
   }
}
